{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "wtroiano/guarded-http",
    "description": "Policy-controlled Laravel HTTP transport with pinned destinations and bounded responses",
    "type": "library",
    "homepage": "https://github.com/wtroiano86/guarded-http",
    "license": "MIT",
    "authors": [
        {
            "name": "William Troiano",
            "email": "opensource.troiano86@pm.me"
        }
    ],
    "support": {
        "issues": "https://github.com/wtroiano86/guarded-http/issues",
        "source": "https://github.com/wtroiano86/guarded-http",
        "security": "https://github.com/wtroiano86/guarded-http/security/policy"
    },
    "require": {
        "ext-curl": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.15.5",
        "guzzlehttp/promises": "^2.5.3",
        "guzzlehttp/psr7": "^2.13.1",
        "illuminate/http": "^13.34",
        "illuminate/support": "^13.34",
        "php": "^8.5.0",
        "psr/http-message": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Wtroiano\\GuardedHttp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wtroiano\\GuardedHttp\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6.2",
        "larastan/larastan": "^3.12.2",
        "laravel/framework": "^13.34.0",
        "laravel/pint": "^1.32.1",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.2.1",
        "pestphp/pest-plugin-type-coverage": "^5.0.2",
        "phpstan/phpstan": "^2.2.16",
        "rector/rector": "^2.6.7"
    },
    "scripts": {
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@test:lint @no_additional_args",
            "@test:types @no_additional_args",
            "@test:type-coverage @no_additional_args",
            "@test:coverage"
        ],
        "lint": [
            "@php vendor/bin/rector process",
            "@php vendor/bin/pint"
        ],
        "test:lint": [
            "@php vendor/bin/pint --test",
            "@php vendor/bin/rector process --dry-run"
        ],
        "test:types": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "test:distribution": "sh .github/scripts/test-distribution.sh",
        "test:all": "@test",
        "test:coverage": "@test:unit --coverage --exactly=100.0",
        "test:type-coverage": "@test:unit --type-coverage --min=100",
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "test:unit": "@php vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "keywords": [
        "laravel",
        "http",
        "ssrf"
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Wtroiano\\GuardedHttp\\Providers\\GuardedHttpServiceProvider"
            ]
        }
    }
}
